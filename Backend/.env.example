PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=dormitory

# Supabase 사용 시 Session pooler 연결 문자열을 넣으면 PostgreSQL로 전환됩니다.
# 비어 있으면 위의 기존 MySQL 설정을 사용합니다. DB 비밀번호는 URL 인코딩합니다.
DATABASE_URL=
DATABASE_SSL=true
# Supabase 공식 CA 인증서 (다른 PostgreSQL 서버는 해당 서버 인증서로 변경)
DATABASE_SSL_CA_FILE=certs/supabase-ca.crt

# 로컬 프론트 주소. 팀 공용 API라면 각 팀원의 프론트 주소를 쉼표로 추가합니다.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_HOURS=24
# HTTPS 배포에서는 true
COOKIE_SECURE=false

# 출석 허용 IP/CIDR. 쉼표로 여러 개 입력합니다. 비어 있으면 학생 출석을 차단합니다.
# 발표 예: 192.168.0.25 / 와이파이 대역 예: 192.168.0.0/24
# 같은 PC에서 백엔드를 직접 호출하는 테스트: 127.0.0.1,::1
ATTENDANCE_ALLOWED_IPS=
# 클라이언트 IP를 전달하는 프록시 서버의 IP/CIDR만 입력합니다. 직접 접속이면 빈 값.
TRUSTED_PROXY_IPS=
