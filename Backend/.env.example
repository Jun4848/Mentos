PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=dormitory

# 로컬 프론트 주소. 팀 공용 API라면 각 팀원의 프론트 주소를 쉼표로 추가합니다.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_HOURS=24
# 32자 이상의 무작위 비밀값을 환경마다 생성하여 설정하세요.
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# HTTPS 배포에서는 true
COOKIE_SECURE=false
